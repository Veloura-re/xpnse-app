# Firebase Configuration
# Copy this file to .env and fill in your actual Firebase credentials
# DO NOT commit .env to version control

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key-here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# OAuth Provider Client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_DISCORD_CLIENT_ID=your-discord-client-id
EXPO_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=your-microsoft-client-id

