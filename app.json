{
  "expo": {
    "name": "spndy",
    "slug": "spndy",
    "version": "1.0.0",
    "description": "Track your expenses",
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "icon": "./assets/images/cashbook-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/cashbook-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000",
      "dark": {
        "image": "./assets/images/cashbook-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cashbook-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.zzz1.businessfinancemanagementappkkqzwnt"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zzz1.businessfinancemanagementappkkqzwnt",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/images/cashbook-icon.png",
      "bundler": "metro",
      "config": {
        "notification": {
          "vapidPublicKey": "BFV_REPLACE_WITH_YOUR_ACTUAL_VAPID_PUBLIC_KEY_FROM_FIREBASE_CONSOLE"
        }
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "notification": {
      "icon": "./assets/images/notification-icon-transparent.png",
      "color": "#10b981",
      "androidMode": "default",
      "androidCollapsedTitle": "spndy"
    },
    "extra": {
      "router": {
        "origin": "https://spndy.app/"
      },
      "eas": {
        "projectId": "7a9025e1-7d9a-4bce-babf-4a77545d859f"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/withNdkOverride"
    ],
    "owner": "lucy-structural"
  }
}
