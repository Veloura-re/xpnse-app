rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isMember(businessId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/businesses/$(businessId)) &&
             request.auth.uid in get(/databases/$(database)/documents/businesses/$(businessId)).data.memberIds;
    }

    // Fast membership check for denormalized data
    function isMemberDenormalized() {
      return isAuthenticated() && 
             (resource == null || request.auth.uid in resource.data.memberIds);
    }
    
    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == 'lucyosck21@gmail.com');
    }
    
    // Businesses & Subcollections
    match /businesses/{businessId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.auth.uid in request.resource.data.memberIds;
      
      allow update: if isAuthenticated() && 
                        (
                          request.auth.uid == resource.data.ownerId || 
                          (
                            request.auth.uid in resource.data.memberIds && 
                            resource.data.members.any(m, m.userId == request.auth.uid && m.role == 'partner')
                          ) ||
                          (
                            request.auth.uid in resource.data.memberIds && 
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
                          ) ||
                          (
                            request.auth.uid in resource.data.memberIds && 
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupPoolBalance'])
                          ) ||
                          (
                            request.auth.uid in resource.data.memberIds && 
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds']) &&
                            !(request.auth.uid in request.resource.data.memberIds)
                          )
                        );
      
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;

      // Grouped standard subcollections
      match /{subcollection}/{docId} {
        allow read, write: if subcollection in ['books', 'parties', 'recurringRules', 'accounts', 'scheduled_stashes', 'group_pools', 'wallet_transactions'] && isMember(businessId);
      }

      match /entries/{entryId} {
        allow read: if isMemberDenormalized() || isMember(businessId);
        allow create, update, delete: if isMember(businessId);
      }

      match /vaults/{vaultId} {
        allow read: if isMember(businessId);
        allow create: if isMember(businessId) && request.resource.data.memberId == request.auth.uid;
        allow update, delete: if isMember(businessId) &&
                                 (resource.data.memberId == request.auth.uid ||
                                  request.auth.uid == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId);
      }

      match /money_requests/{reqId} {
        allow read: if isMember(businessId) && (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.payerId);
        allow create: if isMember(businessId) && request.resource.data.requesterId == request.auth.uid;
        allow update: if isMember(businessId) && (request.auth.uid == resource.data.payerId || request.auth.uid == resource.data.requesterId);
        allow delete: if false;
      }

      match /pending_transfers/{txId} {
        allow read: if isMember(businessId) && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);
        allow create: if isMember(businessId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isMember(businessId) && request.auth.uid == resource.data.recipientId;
        allow delete: if false;
      }
    }
    
    match /invitations/{invitationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.invitedUserId || request.auth.uid == resource.data.invitedBy);
      allow create: if isAuthenticated() && request.resource.data.invitedBy == request.auth.uid && isMember(request.resource.data.businessId);
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.invitedUserId || request.auth.uid == resource.data.invitedBy);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.invitedBy;
    }

    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && isMember(resource.data.businessId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isMember(request.resource.data.businessId);
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || (request.resource.data.businessId != null && isMember(request.resource.data.businessId)));
    }

    match /{path=**}/entries/{entryId} {
      allow read: if isMemberDenormalized();
    }
  }
}
